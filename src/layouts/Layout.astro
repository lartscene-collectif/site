---
import { Image } from 'astro:assets';
import fb from "../assets/facebook.png";
import logo from "../assets/logo.jpg";
import insta from "../assets/insta.png";

interface Props {
	title?: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="fr">
	<head>
		<meta charset="UTF-8" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400..800&display=swap" rel="stylesheet">
		<meta name="viewport" content="width=device-width" />
		<title>{(title ? title+" | " : "") + "Collectif L'Art Scène"}</title>
	</head>
	<body>
		<header>
			<nav>
				<a href="/"><Image src={logo} alt="Logo L'Art Scène" />Collectif L'Art Scène</a>
				<a href="/artistes">Nos Artistes</a>
			</nav>
		</header>
    <main class={!title ? "home" : ""}>
			<slot />
		</main>
		<footer>
      <div>
        <p>Collectif L'Art Scène</p>
        <a href="mailto:lartscene.collectif@gmail.com" title="Nous contacter par email">lartscene.collectif@gmail.com</a>
        <div class="social">
          <a href="https://www.facebook.com/lartscenecollectif" title="Suivez-nous sur Facebook"><Image src={fb} alt="Facebook Logo" /></a> 
          <a href="https://www.instagram.com/lartscene.collectif/" title="Suivez-nous sur Instagram"><Image src={insta} alt="Instagram Logo" /></a> 
        </div>
      </div>
      <div class="links">
				<a href="/contact">Contact</a>
				<a href="/mentions-legales">Mentions légales</a>
				<a href="/politique-de-confidentialite">Politique de confidentialité</a>
			<p>&copy; {new Date().getFullYear()} L'Art Scène Collectif</p>
      </div>
		</footer>
	</body>
</html>

<style>
	:root {
		--fg: #ffffff;
		--muted: #6b7280;
		--accent: #c2410c;
		--bg: #000000;
	}

	html,
	body {
		margin: 0;
		padding: 0;
	}

	body {
    font-family: "Syne", sans-serif;
    font-optical-sizing: auto;
    font-style: normal;
		color: var(--fg);
		background: var(--bg);
		line-height: 1.6;
		display: flex;
		flex-direction: column;
		min-height: 100vh;
	}
  a {
      color: var(--fg);
      text-decoration: none;
  }
	header {
		border-bottom: 1px solid #e5e7eb;
	}

	nav {
		display: flex;
		flex-wrap: wrap;
    gap: 1rem;
		margin: 0 auto;
    img {
      width: 3rem;
      height: auto;
    }
    a {
		font-size: 0.95rem;
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: .5rem;
    }
  }

	nav a:hover {
		color: var(--accent);
	}

	main {
		flex: 1;
		width: 100%;
		margin: 0 auto;
		padding: 1.5rem;
    @media(min-width: 768px) {
		padding: 3rem;
    }
		box-sizing: border-box;
	}

	main :global(img) {
		max-width: 100%;
		height: auto;
		display: block;
	}

	main :global(h1),
	main :global(h2),
	main :global(h3) {
		line-height: 1.25;
	}

	main :global(a) {
		color: var(--accent);
	}

	footer {
    padding: 1rem;
    display: flex;
    flex-direction: column;
    & > div:first-child {
      p {
        font-size: 2rem;
        font-weight: bold;
      }
      a {
        text-decoration: none;
      }
      .social {
        margin-top: 1rem;
        img {
          width: 3rem;
          height: auto;
        }
      }
    }
    .links {
      display: flex;
      justify-content: end;
      flex-direction: column;
      align-items: start;
      font-size: .85rem;
      padding: 1rem;
    }
    @media (min-width: 768px) {
      flex-direction: row;
      justify-content: space-between;
    }
	}

</style>
