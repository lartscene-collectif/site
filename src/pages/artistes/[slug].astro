---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import { resolveAsset } from '../../lib/assets';
import type { ImageMetadata } from 'astro';

export async function getStaticPaths() {
	const entries = await getCollection('artistes');
	return entries.map((e) => ({ params: { slug: e.id }, props: { entry: e } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const cover = entry.data.image_cover ? resolveAsset(entry.data.image_cover) : undefined;

const styles = entry.data.style

function toYoutubeEmbed(url: string): string | undefined {
	try {
		const parsed = new URL(url);
		const videoId = parsed.searchParams.get('v');
		if (videoId) return `https://www.youtube.com/embed/${videoId}`;
		if (parsed.pathname.startsWith('/embed/')) return url;
		if (parsed.hostname === 'youtu.be') {
			const id = parsed.pathname.slice(1);
			if (id) return `https://www.youtube.com/embed/${id}`;
		}
	} catch {
		return undefined;
	}
	return undefined;
}

const gallery: { type: "video"|"image", embed?: string, asset?: ImageMetadata; alt: string }[] = [];

for (const item of entry.data.gallery ?? []) {
	if (item.type === 'youtube') {
		const embed = item.url ? toYoutubeEmbed(item.url) : undefined;
    if (embed) gallery.push({type: "video", embed});
	} else {
		const asset = item.src ? resolveAsset(item.src) : undefined;
    if (asset) gallery.push({ type: "image", asset, alt: item.alt ?? '' });
	}
}
const contactHref = entry.data.contact
	? entry.data.contact.startsWith('mailto:')
		? entry.data.contact
		: `mailto:${entry.data.contact}`
	: undefined;
---

<Layout title={entry.id}>
  <div class="artist">

  <aside>
    <h1>{entry.data.nom}</h1>
	{styles.length > 0 && (
		<section>
			<h2>Style</h2>
				{styles}
		</section>
	)}

	{(entry.data.instagram || entry.data.youtube) && (
		<section>
			<h2>Réseaux</h2>
			<ul>
				{entry.data.instagram && (
					<li>
						<a href={entry.data.instagram}>Instagram</a>
					</li>
				)}
				{entry.data.youtube && (
					<li>
						<a href={entry.data.youtube}>YouTube</a>
					</li>
				)}
			</ul>
		</section>
	)}


	{(entry.data.presse || entry.data.rider) && (
		<section>
			<h2>Liens</h2>
			<ul>
				{entry.data.presse && (
					<li>
						<a href={entry.data.presse}>Dossier de presse</a>
					</li>
				)}
				{entry.data.rider && (
					<li>
						<a href={entry.data.rider}>Rider</a>
					</li>
				)}
			</ul>
		</section>
	)}

  {contactHref && (
		<section>
      <h2>Contact</h2>
      <a href={contactHref}>{entry.data.contact}</a>
    </section>
  )}


	{entry.data.spotify && (
		<iframe
			src={entry.data.spotify}
			width="100%"
			height="352"
			frameBorder="0"
			allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
			allowfullscreen
			loading="lazy"
		/>
	)}
  </aside>
  <article>
	<Content />
  </article>
  </div>

	{gallery.length > 0 && (
		<section class="gallery">
			{gallery.map((item) => (
        item.type === "image" ?
        <Image src={item.asset} alt={item.alt} />
        : <iframe
					src={item.embed}
					title="Vidéo"
					frameBorder="0"
					allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
					allowfullscreen
					loading="lazy"
				/>

			))}
		</section>
	)}
</Layout>

<style>
  h1 {
    font-size: 3.75rem;
    font-weight: bolder;
  }
  .artist {
    display: flex;
    flex-direction: column;
    gap: 3rem;
    @media(min-width: 768px) {
      flex-direction: row;
    }
    aside {
      h2 {
        margin-bottom: 0;
        padding-bottom: 0;
      }
      ul {
        list-style-type: none;
        margin: 0;
        padding: 0;
      }
      a {
        color: white;
      }
      section:last-of-type {
        margin-bottom: 1.5rem;
      }
    }
  }
  .gallery {
    iframe {
      width: 100%;
      aspect-ratio: 16 / 9;
    }
  }
</style>
